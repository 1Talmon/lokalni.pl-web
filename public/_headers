/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
/sitemap-static.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
/sitemap-categories.xml
  Cache-Control: public, max-age=21600, s-maxage=21600, stale-while-revalidate=3600
/sitemap-locations.xml
  Cache-Control: public, max-age=21600, s-maxage=21600, stale-while-revalidate=3600
/sitemap-search.xml
  Cache-Control: public, max-age=21600, s-maxage=21600, stale-while-revalidate=3600
/sitemap-keywords.xml
  Cache-Control: public, max-age=43200, s-maxage=43200, stale-while-revalidate=3600
/sitemap-services.xml
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=900
/sitemap-profiles.xml
  Cache-Control: public, max-age=21600, s-maxage=21600, stale-while-revalidate=3600

/api
  X-Robots-Tag: noindex, nofollow
/api/*
  X-Robots-Tag: noindex, nofollow
