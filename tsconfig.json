{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@capacitor/action-sheet":                ["./src/lib/cap-stubs/action-sheet.ts"],
      "@capacitor/core":                        ["./src/lib/cap-stubs/core.ts"],
      "@capacitor/app":                         ["./src/lib/cap-stubs/app.ts"],
      "@capacitor/haptics":                     ["./src/lib/cap-stubs/haptics.ts"],
      "@capacitor/splash-screen":               ["./src/lib/cap-stubs/splash-screen.ts"],
      "@capacitor/status-bar":                  ["./src/lib/cap-stubs/status-bar.ts"],
      "@capacitor/keyboard":                    ["./src/lib/cap-stubs/keyboard.ts"],
      "@capacitor/camera":                      ["./src/lib/cap-stubs/camera.ts"],
      "@capacitor/push-notifications":          ["./src/lib/cap-stubs/push-notifications.ts"],
      "@capacitor/local-notifications":         ["./src/lib/cap-stubs/local-notifications.ts"],
      "@capacitor/share":                       ["./src/lib/cap-stubs/share.ts"],
      "@capacitor/geolocation":                 ["./src/lib/cap-stubs/geolocation.ts"],
      "capacitor-secure-storage-plugin":        ["./src/lib/cap-stubs/secure-storage.ts"],
      "@aparajita/capacitor-biometric-auth":    ["./src/lib/cap-stubs/biometric-auth.ts"],
      "@capacitor-community/facebook-login":    ["./src/lib/cap-stubs/facebook-login.ts"],
      "@codetrix-studio/capacitor-google-auth": ["./src/lib/cap-stubs/google-auth.ts"]
    },
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "capacitor.config.ts", "scripts", "vite.config.ts", "src/main.tsx", "src/vite-env.d.ts"]
}
