  "cards": [
    {
      "dot": "cyan",
      "title": "Platform",
      "items": [
        "Capacitor (com.lokalni.test) wraps the web app for iOS/Android; CapacitorHttp monkey-patches window.fetch on native; safe-area insets via CSS env()",
        "nginx serves dist/ on web; CSP, HSTS, X-Frame-Options set as HTTP response headers (not meta tags)"
      ]
    },
    {
      "dot": "emerald",
      "title": "State",
      "items": [
        "useAppLogic is the single mega-hook owning ALL global state (auth, services, chat, favorites, modals, map) — no Context, no Redux; props-drilled to every top-level view",
        "React Query hooks (useMyProfile, useNotifications, usePublicProfile) layer server-synced data on top"
      ]
    },
    {
      "dot": "rose",
      "title": "Auth / Security",
      "items": [
        "JWT stored in localStorage under key 'userToken' (known limitation; httpOnly cookie requires backend change)",
        "apiClient auto-refreshes on 401 via /auth/refresh; tokenUtils.clearAll() auto-logouts on expiry or tab visibility change"
      ]
    }
  ]
}
